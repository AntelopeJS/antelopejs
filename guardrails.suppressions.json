{
  "rules": {
    "anti-slop/no-known-value-widening": 2,
    "anti-slop/no-runtime-typeof": 1,
    "anti-slop/no-unknown-parameters": 34,
    "anti-slop/no-unknown-returns": 10,
    "anti-slop/no-unsafe-dictionary-type": 9,
    "anti-slop/require-safety-comment-for-type-assertion": 4,
    "eslint/no-control-regex": 1,
    "import/no-cycle": 0,
    "import/no-self-import": 0,
    "typescript/no-base-to-string": 0,
    "typescript/no-redundant-type-constituents": 2,
    "typescript/no-unsafe-assignment": 3,
    "typescript/no-unsafe-return": 4
  },
  "tsExpectError": 0,
  "tsIgnore": 0,
  "safety": 5,
  "config": {},
  "agentFiles": true
}
