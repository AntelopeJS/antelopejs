{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "verify-greeter": [
        "./fixtures/greeter/verify-greeter/index.js"
      ]
    }
  },
  "include": [
    "verify.config.ts",
    "bin/**/*.mts",
    "fixtures/hosts/*.mjs",
    "fixtures/greeter/*/index.js",
    "fixtures/template-verify-http/test/*.js"
  ]
}
