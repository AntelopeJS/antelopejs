{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "module": "preserve",
    "moduleResolution": "bundler",
    "rootDir": "..",
    "paths": {
      "@antelopejs/core": ["../src/index.ts"],
      "@antelopejs/core/cli": ["../src/core/cli/public.ts"]
    }
  },
  "include": ["./**/*.ts", "./**/*.cjs", "./**/*.mjs"],
  "ts-node": {
    "transpileOnly": true,
    "compilerOptions": {
      "module": "commonjs",
      "moduleResolution": "node10"
    }
  }
}
