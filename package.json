{
  "name": "@antelopejs/core",
  "version": "1.18.1",
  "description": "TypeScript framework extending hexagonal architecture across your application and its ecosystem through explicit contracts and replaceable modules.",
  "keywords": [
    "antelopejs",
    "cli",
    "framework",
    "hexagonal-architecture",
    "modular",
    "ports-and-adapters",
    "typescript"
  ],
  "homepage": "https://framework.antelopejs.com",
  "bugs": {
    "url": "https://github.com/AntelopeJS/antelopejs/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/antelopejs.git"
  },
  "bin": {
    "ajs": "dist/core/cli/index.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/core/cli/public.d.ts",
      "default": "./dist/core/cli/public.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && release-it",
    "lint": "oxlint && pnpm run deps",
    "deps": "depcruise src test --config .dependency-cruiser.cjs",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "test": "pnpm test:coverage && pnpm build && ts-node test/embedded/run.ts && ts-node test/package-consumer/run.ts && pnpm --dir playground install && ts-node playground/test-playground.ts",
    "test:unit": "mocha --require ts-node/register --require test/setup.ts 'test/**/*.test.ts' --exit",
    "test:package-consumer": "pnpm build && ts-node test/package-consumer/run.ts",
    "test:playground": "pnpm build && pnpm --dir playground install && ts-node playground/test-playground.ts",
    "test:watch": "mocha --require ts-node/register --require test/setup.ts --watch --watch-extensions ts 'test/**/*.test.ts'",
    "test:coverage": "c8 --check-coverage --lines 90 --functions 90 --branches 90 --statements 90 mocha --require ts-node/register --require test/setup.ts 'test/**/*.test.ts' --exit",
    "test:embedded": "pnpm build && ts-node test/embedded/run.ts",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1; then lefthook install; fi",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "sync": "antelopejs-sync",
    "sync:check": "antelopejs-sync --check",
    "typecheck": "tsc --noEmit && tsc -p test && tsc -p .agents/skills/verify-antelopejs && tsc -p .agents/skills/formal-module-lifecycle",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update",
    "ratchet": "antelopejs-ratchet",
    "ratchet:update": "antelopejs-ratchet --update"
  },
  "dependencies": {
    "@antelopejs/interface-core": ">=0.3.0 <0.4.0",
    "@clack/prompts": "^1.8.1",
    "@types/proper-lockfile": "^4.1.4",
    "commander": "^13.1.0",
    "inly": "^5.0.1",
    "jiti": "^2.6.1",
    "mocha": "^11.7.5",
    "picocolors": "^1.1.1",
    "proper-lockfile": "^4.1.2",
    "reflect-metadata": "^0.2.2",
    "semver": "^7.7.4",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@antelopejs/core": "link:.",
    "@antelopejs/interface-api": "0.1.0",
    "@antelopejs/interface-auth": "0.1.0",
    "@antelopejs/interface-data-api": "0.5.0",
    "@antelopejs/interface-database": "0.2.0",
    "@antelopejs/interface-database-decorators": "0.1.11",
    "@antelopejs/interface-email": "0.1.0",
    "@antelopejs/tooling-configs": "^0.2.17",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "@types/semver": "^7.7.1",
    "@types/sinon": "^17.0.4",
    "c8": "^10.1.3",
    "chai": "^4.5.0",
    "dependency-cruiser": "^18.7.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "fast-check": "4.10.2",
    "knip": "^6.34.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "sinon": "^17.0.2",
    "ts-node": "^10.9.2"
  },
  "c8": {
    "exclude": [
      "src/**/*.d.ts"
    ],
    "include": [
      "src/**/*.ts"
    ],
    "report-dir": "coverage",
    "reporter": [
      "text",
      "html"
    ]
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.6.5",
  "antelopeJs": {
    "implements": [
      "@antelopejs/interface-core"
    ],
    "skills": [
      "./skills"
    ]
  }
}
